generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("tiktok")
  optInAt   DateTime @default(now())
  createdAt DateTime @default(now())
}

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String    // Hashed with bcrypt
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique              // Format "TG-XXXX" lisible
  status       String   @default("NOUVELLE") // NOUVELLE | CONTACTEE | RDV_FIXE | REMISE | ANNULEE

  // Client
  firstName    String
  lastName     String
  email        String
  phone        String
  city         String
  postalCode   String?
  message      String?                       // "Un message pour Yvana ?"

  // Teintes choisies
  carnation    String                        // claire | medium | tan | profonde
  fondDeTeint  String                        // F1, F2, etc.
  antiCernes   String                        // AC1, AC2, etc.

  // Consentements
  newsletter   Boolean  @default(false)
  cgvAccepted  Boolean  @default(true)

  // Champs de gestion back-office (Étape 3)
  meetingDate     DateTime?
  meetingLocation String?
  paymentMethod   String?                    // "especes", "virement", "paypal"
  paymentAmount   Float?

  // Champs activation QR Code (Étape 4)
  activationToken String?  @unique   // Token secret 32 hex, généré à la remise
  activationCode  String?  @unique   // Code court lisible ex: TG-4K9P
  activatedAt     DateTime?          // Date du premier scan (Étape 5)
  userId          String?            // Utilisateur qui a activé la commande

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User?    @relation(fields: [userId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Mot de passe haché
  firstName String
  
  orders    Order[]  // Commandes activées par cet utilisateur

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
